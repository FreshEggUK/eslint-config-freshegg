{
  "name": "eslint-config-freshegg",
  "version": "1.0.7",
  "description": "ESLint and Prettier Config",
  "keywords": [
    "javascript",
    "typescript",
    "ecmascript",
    "eslint",
    "eslintconfig",
    "lint",
    "config",
    "prettier"
  ],
  "main": "index.js",
  "repository": "git@github.com:FreshEggUK/eslint-config-freshegg.git",
  "author": "Fresh Egg <development@freshegg.com>",
  "license": "MIT",
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:ts": "eslint --config typescript.js typescript-demo.ts",
    "lint:ts:fix": "eslint --config typescript.js typescript-demo.ts --fix",
    "bump:beta": "npm version prerelease --preid beta",
    "publish:beta": "npm publish --tag beta"
  },
  "peerDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@rushstack/eslint-patch": "^1.10.5",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-html": "^8.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "typescript-eslint": "^8.23.0"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0"
  }
}
